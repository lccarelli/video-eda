{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:videoeda:schema:comment-deleted",
  "title": "CommentDeleted",
  "description": "El autor borró su comentario.",
  "allOf": [
    { "$ref": "urn:videoeda:schema:cloudevent-envelope" },
    {
      "properties": {
        "type": { "const": "dev.videoeda.interactions.comment-deleted" },
        "source": { "const": "/interactions" },
        "data": {
          "type": "object",
          "required": ["commentId", "videoId", "deletedAt"],
          "properties": {
            "commentId": { "type": "string", "pattern": "^cmt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
            "videoId": { "type": "string", "pattern": "^vid_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
            "deletedAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  ]
}
