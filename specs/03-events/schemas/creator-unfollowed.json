{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:videoeda:schema:creator-unfollowed",
  "title": "CreatorUnfollowed",
  "description": "Un viewer dejó de seguir a un creator.",
  "allOf": [
    { "$ref": "urn:videoeda:schema:cloudevent-envelope" },
    {
      "properties": {
        "type": { "const": "dev.videoeda.feed.creator-unfollowed" },
        "source": { "const": "/feed" },
        "data": {
          "type": "object",
          "required": ["followerId", "creatorId", "unfollowedAt"],
          "properties": {
            "followerId": { "type": "string", "pattern": "^usr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
            "creatorId": { "type": "string", "pattern": "^usr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
            "unfollowedAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  ]
}
