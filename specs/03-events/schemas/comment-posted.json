{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:videoeda:schema:comment-posted",
  "title": "CommentPosted",
  "description": "Un viewer publicó un comentario sobre un video.",
  "allOf": [
    { "$ref": "urn:videoeda:schema:cloudevent-envelope" },
    {
      "properties": {
        "type": { "const": "dev.videoeda.interactions.comment-posted" },
        "source": { "const": "/interactions" },
        "data": {
          "type": "object",
          "required": ["commentId", "videoId", "authorId", "text", "postedAt"],
          "properties": {
            "commentId": { "type": "string", "pattern": "^cmt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
            "videoId": { "type": "string", "pattern": "^vid_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
            "authorId": { "type": "string", "pattern": "^usr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
            "text": { "type": "string", "minLength": 1 },
            "postedAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  ]
}
