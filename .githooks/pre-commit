#!/usr/bin/env bash

set -euo pipefail

GITLEAKS_IMAGE="ghcr.io/gitleaks/gitleaks:v8.30.1"
ROOT="$(git rev-parse --show-toplevel)"

if ! docker info >/dev/null 2>&1; then
  echo "pre-commit: Docker no responde, así que no puedo buscar secretos. Levantá Docker y reintentá." >&2
  exit 1
fi

exec docker run --rm -v "$ROOT:/repo" -w /repo "$GITLEAKS_IMAGE" git --pre-commit --staged --redact --verbose --config /repo/.gitleaks.toml
